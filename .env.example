# APEX Events & Competitions — environment configuration
# Copy this file to `.env` (or set these in your hosting panel), then edit the values.
# The web server (and PHP processes) must be able to read it.
# NEVER commit your real .env file.

# --- Application
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi

# --- Database
# Local XAMPP defaults:
#   DB_HOST=localhost  DB_NAME=u599227834_apex_db  DB_USER=root  DB_PASS=
# Hostinger / shared hosting (values from hPanel → Databases):
#   DB_HOST=localhost  DB_NAME=u599227834_apex_db  DB_USER=u599227834_xxxxx  DB_PASS=<your-db-password>
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u599227834_apex_db
DB_USER=root
DB_PASS=

# --- Email / SMTP (optional; the admin UI also stores these)
# For Hostinger-hosted mailboxes (Titan / Hostinger Email):
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_ENCRYPTION=ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@apexcompetitions.org
SMTP_FROM_NAME="APEX Events & Competitions"
SMTP_ENCRYPTION=tls

# --- Admin notifications
ADMIN_NOTIFY_EMAIL=admin@apexcompetitions.org

# --- Site URL (used in canonical links and email templates)
APP_URL=https://apexcompetitions.org
